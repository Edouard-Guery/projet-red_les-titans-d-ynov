package main

import (
	"encoding/json"
	"net/http"
	"sync"
)

var heroGlobal *Personnage
var monstreGlobal *Monstre
var combatEnCours bool
var logsCombat []string
var mu sync.Mutex

type GameState struct {
	Hero     *Personnage `json:"hero"`
	Monstre  *Monstre    `json:"monstre"`
	EnCombat bool        `json:"en_combat"`
	Logs     []string    `json:"logs"`
}

func LancerServeurWeb(hero *Personnage) {
	heroGlobal = hero

	http.HandleFunc("/api/stats", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.Header().Set("Access-Control-Allow-Origin", "*")

		mu.Lock()
		state := GameState{
			Hero:     heroGlobal,
			Monstre:  monstreGlobal,
			EnCombat: combatEnCours,
			Logs:     logsCombat,
		}
		mu.Unlock()

		if heroGlobal != nil {
			json.NewEncoder(w).Encode(state)
		}
	})

	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		http.ServeFile(w, r, "index.html")
	})

	http.ListenAndServe(":8080", nil)
}

func SetCombatState(m *Monstre, enCours bool) {
	mu.Lock()
	monstreGlobal = m
	combatEnCours = enCours
	if enCours {
		logsCombat = []string{} // Vide l'historique au début d'un nouveau combat
	}
	mu.Unlock()
}

// Fonction à appeler dans le jeu pour envoyer du texte au site web
func AddLog(msg string) {
	mu.Lock()
	logsCombat = append(logsCombat, msg)
	// Ne garde que les 30 derniers logs pour ne pas surcharger la page
	if len(logsCombat) > 30 {
		logsCombat = logsCombat[len(logsCombat)-30:]
	}
	mu.Unlock()
}
