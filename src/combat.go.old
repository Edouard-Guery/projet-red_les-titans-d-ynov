package main

import (
	"fmt"
	"math/rand/v2"
)

type attaque struct {
	Nom           string
	Dommage       int
	regeneration  int
	defense       int
	CoutEndurance int
}

var (
	MorsureVeneuse     = attaque{"Morsure Vénéneuse", 12, 0, 0, 5}
	CoupDeBouclier     = attaque{"Coup de Bouclier", 5, 0, 15, 8}
	VampirismeSauvage  = attaque{"Vampirisme Sauvage", 15, 10, 0, 12}
	FureurHeroique     = attaque{"Fureur Héroïque", 35, 0, -5, 15}
	EgideDeBronze      = attaque{"Égide de Bronze", 10, 5, 30, 20}
	EclairCeleste      = attaque{"Éclair Céleste", 50, 0, 0, 25}
	CataclysmeCosmique = attaque{"Cataclysme Cosmique", 100, 0, 0, 45}
	JugementAbsolu     = attaque{"Jugement Absolu", 150, 0, 50, 60}
	RenaissanceDivine  = attaque{"Renaissance Divine", 20, 100, 50, 80}
)

type Combat struct {
	Joueur  *Personnage
	Monstre *Monstre
	Tour    int
}

func NouveauCombat(p *Personnage, m *Monstre) *Combat {
	return &Combat{
		Joueur:  p,
		Monstre: m,
		Tour:    1,
	}
}

func (c *Combat) LancerDéroulement() {
	SetCombatState(c.Monstre, true)
	AddLog(fmt.Sprintf("⚔️ Le combat contre %s commence !", c.Monstre.Nom))

	fmt.Println("\n" + Magenta + "============================================================" + Reset)
	fmt.Printf(Bold+Red+"          ⚔️  DÉBUT DU COMBAT : %s VS %s ⚔️\n"+Reset, c.Joueur.Nom, c.Monstre.Nom)
	fmt.Println(Magenta + "============================================================" + Reset)

	for c.Joueur.PV > 0 && c.Monstre.PV > 0 {
		fmt.Printf("\n"+Yellow+"--- ⏳ Tour %d ---"+Reset+"\n", c.Tour)
		AddLog(fmt.Sprintf("--- ⏳ Tour %d ---", c.Tour))

		if c.Monstre.EstEmpoisonne && c.Monstre.PV > 0 {
			c.Monstre.PV -= c.Monstre.DegatsPoison
			if c.Monstre.PV < 0 { c.Monstre.PV = 0 }
			msg := fmt.Sprintf("☠️ %s souffre du poison (-%d PV)", c.Monstre.Nom, c.Monstre.DegatsPoison)
			fmt.Println(Red + msg + Reset)
			AddLog(msg)

			if c.Monstre.PV <= 0 { break }
		}

		c.Joueur.Endurance += 15
		if c.Joueur.Endurance > c.Joueur.EnduranceMax { c.Joueur.Endurance = c.Joueur.EnduranceMax }

		if c.Joueur.Inventaire["GourdeRegeneration"] > 0 {
			fmt.Println(Green + "🌿 La Gourde restaure vos PV !" + Reset)
			c.Joueur.GourdeRegeneration()
			AddLog("🌿 La Gourde de Régénération restaure vos PV !")
		}

		fmt.Printf(Cyan+"👤 %s "+Reset+"| ❤️ PV : %d/%d | ⚡ Endu : %d/%d | 🗡️ Attaque : %d | 🛡️ Défense : %d\n", c.Joueur.Nom, c.Joueur.PV, c.Joueur.PVMax, c.Joueur.Endurance, c.Joueur.EnduranceMax, c.Joueur.Attaque, c.Joueur.Defense)
		fmt.Printf(Red+"👹 %s "+Reset+"| ❤️ PV : %d/%d\n", c.Monstre.Nom, c.Monstre.PV, c.Monstre.PVMax)

		c.TourJoueur()

		if c.Monstre.PV <= 0 {
			recompense := (c.Monstre.PVMax / 10) + rand.N(10)
			if recompense < 40 { recompense = 40 }
			c.Joueur.Argent += recompense

			AddLog(fmt.Sprintf("🏆 VICTOIRE ! Vous gagnez %d oboles.", recompense))
			fmt.Println("\n" + Magenta + "============================================================" + Reset)
			fmt.Printf(Bold+Green+"🏆 VICTOIRE ! %s a vaincu %s !\n"+Reset, c.Joueur.Nom, c.Monstre.Nom)
			fmt.Printf(Yellow+"💰 Le butin s'élève à %d oboles !\n"+Reset, recompense)
			fmt.Println(Magenta + "============================================================" + Reset)
			break
		}

		c.TourMonstre()

		if c.Joueur.PV <= 0 {
			AddLog("💀 DÉFAITE... Vous êtes terrassé.")
			break
		}

		c.Tour++
	}

	c.Monstre.EstEmpoisonne = false
	c.Monstre.DegatsPoison = 0

	if c.Monstre.PV <= 0 {
		fmt.Println("\n" + Magenta + "============================================================" + Reset)
		fmt.Printf(Bold+Green+"🏆 %s sort victorieux du combat !\n"+Reset, c.Joueur.Nom)
		fmt.Println(Magenta + "============================================================" + Reset)
	} else {
		fmt.Println("\n" + Magenta + "============================================================" + Reset)
		fmt.Printf(Bold+Red+"💀 DÉFAITE... %s a été terrassé par %s.\n"+Reset, c.Joueur.Nom, c.Monstre.Nom)
		fmt.Println(Magenta + "============================================================" + Reset)
	}

	SetCombatState(nil, false)
}

func (c *Combat) TourJoueur() {
	for {
		fmt.Println("\n" + Blue + "------------------------------------------------------------" + Reset)
		fmt.Printf(Cyan+"👤 C'est à votre tour, %s !"+Reset+"\n", c.Joueur.Nom)

		coutBase := 5
		fmt.Printf(White+" 1. Attaque de base (%d dégâts, %d ⚡)\n"+Reset, c.Joueur.Attaque, coutBase)

		offset := 2
		for i, att := range c.Joueur.AttaquesApprises {
			fmt.Printf(White+" %d. %s (%d dégâts base, %d soin, %d ⚡)\n"+Reset, i+offset, att.Nom, att.Dommage, att.regeneration, att.CoutEndurance)
		}

		indexObjet := len(c.Joueur.AttaquesApprises) + offset
		fmt.Printf(Yellow+" %d. Utiliser un objet (Potion)\n"+Reset, indexObjet)
		fmt.Println(Blue + "------------------------------------------------------------" + Reset)

		var choix int
		fmt.Print(Cyan + "👉 Choisissez une action : " + Reset)
		fmt.Scanln(&choix)

		if choix == 1 {
			if c.Joueur.Endurance >= coutBase {
				c.Joueur.Endurance -= coutBase
				c.ExecuterAttaqueJoueur("Attaque de base", c.Joueur.Attaque, 0, 0)
				break
			} else {
				fmt.Println(Red + "❌ Pas assez d'endurance !" + Reset)
			}
		} else if choix >= offset && choix < indexObjet {
			att := c.Joueur.AttaquesApprises[choix-offset]
			if c.Joueur.Endurance >= att.CoutEndurance {
				c.Joueur.Endurance -= att.CoutEndurance
				c.ExecuterAttaqueJoueur(att.Nom, att.Dommage+c.Joueur.Attaque, att.regeneration, att.defense)
				break
			} else {
				fmt.Println(Red + "❌ Pas assez d'endurance !" + Reset)
			}
		} else if choix == indexObjet {
			if c.Joueur.utiliserObjetdurantcombat(c.Monstre) { break }
		} else {
			fmt.Println(Red + "❌ Choix invalide !" + Reset)
		}
	}
}

func (p *Personnage) utiliserObjetdurantcombat(m *Monstre) bool {
	potionsDispo := []string{}
	for nom, qte := range p.Inventaire {
		if qte > 0 && strings.Contains(nom, "Potion") {
			potionsDispo = append(potionsDispo, nom)
		}
	}

	if len(potionsDispo) == 0 {
		fmt.Println(Red + "⚠️ Vous n'avez aucune potion utilisable !" + Reset)
		return false
	}

	for i, nom := range potionsDispo {
		fmt.Printf(White+" %d. %s (x%d)\n"+Reset, i+1, nom, p.Inventaire[nom])
	}

	var choix int
	fmt.Print(Cyan + "👉 Choisissez une potion (0 pour annuler) : " + Reset)
	fmt.Scanln(&choix)

	if choix <= 0 || choix > len(potionsDispo) { return false }

	nomChoisi := potionsDispo[choix-1]

	switch nomChoisi {
	case "Potion de vie (+)":
		p.PV += 30
		if p.PV > p.PVMax { p.PV = p.PVMax }
		AddLog("🧪 Vous buvez une Potion de vie (+) [+30 PV]")
	case "Potion de vie (++)":
		p.PV += 80
		if p.PV > p.PVMax { p.PV = p.PVMax }
		AddLog("🧪 Vous buvez une Potion de vie (++) [+80 PV]")
	case "Potion d'attaque (+)":
		p.Attaque += 10
		AddLog("🧪 Votre attaque augmente de 10 !")
	case "Potion de défense (+)":
		p.Defense += 10
		AddLog("🧪 Votre défense augmente de 10 !")
	}

	p.Inventaire[nomChoisi]--
	if p.Inventaire[nomChoisi] <= 0 { delete(p.Inventaire, nomChoisi) }
	return true
}

func (c *Combat) ExecuterAttaqueJoueur(nomAttaque string, degatsBruts, regen, defBonus int) {
	msg := fmt.Sprintf("⚔️ Vous lancez [%s].", nomAttaque)
	fmt.Println(Bold + Cyan + msg + Reset)
	AddLog(msg)

	chanceCritique := rand.N(100)
	if chanceCritique < 15 {
		degatsBruts = int(float64(degatsBruts) * 1.5)
		fmt.Println(Bold + Yellow + "   💥 COUP CRITIQUE !" + Reset)
		AddLog("💥 COUP CRITIQUE !")
	}

	degatsNets := degatsBruts - (c.Monstre.Defense / 2)
	if degatsNets < 2 { degatsNets = 2 }

	c.Monstre.PV -= degatsNets
	if c.Monstre.PV < 0 { c.Monstre.PV = 0 }

	msgDegat := fmt.Sprintf("💥 %s subit %d dégâts.", c.Monstre.Nom, degatsNets)
	fmt.Println(Red + "   " + msgDegat + Reset)
	AddLog(msgDegat)

	if regen > 0 {
		c.Joueur.PV += regen
		if c.Joueur.PV > c.Joueur.PVMax { c.Joueur.PV = c.Joueur.PVMax }
		msgSoin := fmt.Sprintf("💚 Vous vous soignez de %d PV.", regen)
		fmt.Println(Green + "   " + msgSoin + Reset)
		AddLog(msgSoin)
	}

	if defBonus > 0 {
		c.Joueur.Defense += defBonus
		msgDef := fmt.Sprintf("🛡️ Posture renforcée (+%d Def).", defBonus)
		fmt.Println(Blue + "   " + msgDef + Reset)
		AddLog(msgDef)
	}
}