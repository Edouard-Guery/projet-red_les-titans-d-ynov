<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Titans d'Ynov - Live Dashboard</title>
    <style>
        :root {
            --bg-color: #0b0c10;
            --panel-bg: #1f2833;
            --neon-cyan: #66fcf1;
            --neon-blue: #45a29e;
            --neon-red: #ff003c;
            --gold: #ffd700;
            --text-main: #c5c6c7;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
        }

        h1, h2, h3 { margin-top: 0; text-transform: uppercase; }
        
        .dashboard-grid {
            display: grid;
            grid-template-columns: 300px 500px 300px;
            gap: 20px;
            width: 100%;
            max-width: 1200px;
        }

        .panel {
            background: rgba(31, 40, 51, 0.8);
            border: 1px solid var(--neon-blue);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 0 15px rgba(69, 162, 158, 0.2);
            backdrop-filter: blur(5px);
        }

        /* En-tête du Héros */
        .hero-title { color: var(--neon-cyan); text-align: center; font-size: 24px; border-bottom: 1px solid var(--neon-blue); padding-bottom: 10px; margin-bottom: 15px;}
        .stat-row { display: flex; justify-content: space-between; margin: 8px 0; font-size: 16px; font-weight: 600; }
        .stat-val { color: white; text-shadow: 0 0 5px rgba(255,255,255,0.5); }

        /* Barres de progression */
        .bar-bg { background: #111; height: 18px; border-radius: 4px; overflow: hidden; border: 1px solid #333; margin-top: 4px; margin-bottom: 15px;}
        .bar-fill { height: 100%; transition: width 0.3s ease-out; }
        .bar-hp { background: linear-gradient(90deg, #8b0000, var(--neon-red)); box-shadow: 0 0 10px var(--neon-red); }
        .bar-endu { background: linear-gradient(90deg, #b8860b, var(--gold)); box-shadow: 0 0 10px var(--gold); }

        /* Inventaire */
        .inventory-list { list-style: none; padding: 0; margin: 0; font-size: 14px; }
        .inventory-list li { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid #333; }
        .inventory-list li span { color: var(--neon-cyan); font-weight: bold; }

        /* Arène de Combat */
        .arena-panel { border-color: var(--neon-red); box-shadow: 0 0 20px rgba(255, 0, 60, 0.3); text-align: center; position: relative;}
        .arena-title { color: var(--neon-red); font-size: 22px; letter-spacing: 2px;}
        
        .combat-zone { display: flex; justify-content: space-between; align-items: center; margin-top: 20px;}
        .fighter { width: 45%; padding: 15px; background: #111; border-radius: 8px; border: 1px solid #333; }
        .fighter h3 { font-size: 18px; margin-bottom: 10px;}
        
        .vs-badge { font-size: 30px; font-weight: 900; color: var(--gold); text-shadow: 0 0 15px var(--gold); font-style: italic;}
        .monster-name { color: var(--neon-red); }
        .hero-name { color: var(--neon-cyan); }
        .avatar { font-size: 60px; margin: 10px 0; }

        .peaceful-zone { text-align: center; padding: 50px 0; color: var(--neon-blue); }
        .peaceful-zone .avatar { font-size: 80px; opacity: 0.5; }

        /* Historique Console */
        .log-box {
            background: #000;
            border: 1px solid #444;
            border-radius: 5px;
            height: 140px;
            overflow-y: auto;
            margin-top: 20px;
            padding: 10px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            text-align: left;
            color: #ccc;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        .log-entry { padding: 3px 0; border-bottom: 1px dashed #222; }

        /* Animation Dégâts */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-5px); border-color: red;}
            40%, 80% { transform: translateX(5px); border-color: red;}
        }
        .damage-shake { animation: shake 0.3s; }
    </style>
</head>
<body>

<div class="dashboard-grid">
    
    <!-- PANNEAU GAUCHE : STATS DU HÉROS -->
    <div class="panel">
        <div class="hero-title">👤 <span id="h-nom">Héros</span></div>
        <div style="text-align: center; margin-bottom: 15px; color: var(--neon-blue);">Niveau <span id="h-niv" class="stat-val">1</span> • <span id="h-classe" class="stat-val">Classe</span></div>

        <div class="stat-row"><span>❤️ Santé</span><span class="stat-val" id="h-pv-txt">0 / 0</span></div>
        <div class="bar-bg"><div class="bar-fill bar-hp" id="h-pv-bar" style="width: 100%;"></div></div>

        <div class="stat-row"><span>⚡ Endurance</span><span class="stat-val" id="h-endu-txt">0 / 0</span></div>
        <div class="bar-bg"><div class="bar-fill bar-endu" id="h-endu-bar" style="width: 100%;"></div></div>

        <div class="stat-row"><span>🗡️ Attaque</span><span class="stat-val" id="h-atk">0</span></div>
        <div class="stat-row"><span>🛡️ Défense</span><span class="stat-val" id="h-def">0</span></div>
        <div class="stat-row"><span>💰 Oboles</span><span class="stat-val" id="h-or" style="color:var(--gold)">0</span></div>
    </div>

    <!-- PANNEAU CENTRAL : ARÈNE DE COMBAT -->
    <div class="panel arena-panel" id="arena-panel">
        
        <div id="combat-active" style="display: none;">
            <div class="arena-title">⚔️ COMBAT EN COURS ⚔️</div>
            
            <div class="combat-zone">
                <div class="fighter" id="hero-fighter">
                    <h3 class="hero-name" id="f-hero-nom">Héros</h3>
                    <div class="avatar">🛡️</div>
                    <div class="stat-val" id="f-hero-pv-txt" style="margin-bottom: 5px;">0 / 0 PV</div>
                    <div class="bar-bg" style="height: 10px; margin-bottom: 0;"><div class="bar-fill bar-hp" id="f-hero-pv-bar" style="width: 100%;"></div></div>
                </div>

                <div class="vs-badge">VS</div>

                <div class="fighter" id="monster-fighter" style="border-color: var(--neon-red);">
                    <h3 class="monster-name" id="m-nom">Monstre</h3>
                    <div class="avatar" id="m-avatar">👹</div>
                    <div class="stat-val" id="m-pv-txt" style="margin-bottom: 5px;">0 / 0 PV</div>
                    <div class="bar-bg" style="height: 10px; margin-bottom: 0;"><div class="bar-fill bar-hp" id="m-pv-bar" style="width: 100%;"></div></div>
                </div>
            </div>

            <!-- Historique des événements de combat -->
            <div class="log-box" id="combat-logs">
                <div style="color:gray; text-align:center; margin-top:50px;">En attente du début du combat...</div>
            </div>
        </div>

        <div id="combat-idle" class="peaceful-zone">
            <div class="avatar">🏛️</div>
            <h2>L'Olympe est calme...</h2>
            <p>Explorez les menus dans votre terminal, reposez-vous ou préparez-vous au prochain affrontement.</p>
        </div>
    </div>

    <!-- PANNEAU DROIT : INVENTAIRE -->
    <div class="panel">
        <h3 style="color: var(--gold); border-bottom: 1px solid var(--gold); padding-bottom: 10px; text-align: center;">🎒 INVENTAIRE (<span id="h-inv-count">0</span>/<span id="h-inv-max">0</span>)</h3>
        <ul class="inventory-list" id="inventory-list">
            <li>Chargement...</li>
        </ul>
    </div>

</div>

<script>
    let lastHeroHP = -1;
    let lastMonsterHP = -1;
    let lastLogCount = 0; // Pour ne pas tout rafraîchir en boucle inutilement

    function getMonsterEmoji(nom) {
        nom = nom.toLowerCase();
        if (nom.includes("orc")) return "🧟";
        if (nom.includes("méduse")) return "🐍";
        if (nom.includes("minotaure")) return "🐂";
        if (nom.includes("hydre")) return "🐉";
        if (nom.includes("cerbère")) return "🐺";
        if (nom.includes("zeus")) return "🌩️";
        if (nom.includes("hadès")) return "💀";
        if (nom.includes("poséidon")) return "🌊";
        if (nom.includes("chronos")) return "⏳";
        return "👹";
    }

    async function updateDashboard() {
        try {
            const response = await fetch('http://localhost:8080/api/stats');
            const data = await response.json();
            const hero = data.hero;
            const monstre = data.monstre;
            const enCombat = data.en_combat;
            const logs = data.logs || [];

            if (!hero) return;

            /* --- MISE A JOUR STATS DU HEROS --- */
            document.getElementById('h-nom').innerText = hero.Nom;
            document.getElementById('h-niv').innerText = hero.Niveau;
            document.getElementById('h-classe').innerText = hero.Classe;
            
            document.getElementById('h-pv-txt').innerText = hero.PV + " / " + hero.PVMax;
            document.getElementById('h-pv-bar').style.width = (hero.PV / hero.PVMax * 100) + "%";
            document.getElementById('h-endu-txt').innerText = hero.Endurance + " / " + hero.EnduranceMax;
            document.getElementById('h-endu-bar').style.width = (hero.Endurance / hero.EnduranceMax * 100) + "%";

            document.getElementById('h-atk').innerText = hero.Attaque;
            document.getElementById('h-def').innerText = hero.Defense;
            document.getElementById('h-or').innerText = hero.Argent;

            // Animation Dégâts Héros
            if (lastHeroHP !== -1 && hero.PV < lastHeroHP) {
                let pnl = document.getElementById('hero-fighter');
                pnl.classList.remove('damage-shake');
                void pnl.offsetWidth; 
                pnl.classList.add('damage-shake');
            }
            lastHeroHP = hero.PV;

            /* --- MISE A JOUR INVENTAIRE --- */
            let count = 0;
            let invHTML = "";
            for (const [item, qte] of Object.entries(hero.Inventaire)) {
                count += qte;
                invHTML += `<li>${item} <span>x${qte}</span></li>`;
            }
            if (count === 0) invHTML = `<li style="color:gray; justify-content:center;">Sac vide</li>`;
            
            document.getElementById('h-inv-count').innerText = count;
            document.getElementById('h-inv-max').innerText = hero.CapaciteMax;
            document.getElementById('inventory-list').innerHTML = invHTML;

            /* --- GESTION DE L'ARÈNE ET LOGS --- */
            if (enCombat && monstre) {
                document.getElementById('combat-idle').style.display = "none";
                document.getElementById('combat-active').style.display = "block";
                document.getElementById('arena-panel').style.borderColor = "var(--neon-red)";

                document.getElementById('f-hero-nom').innerText = hero.Nom;
                document.getElementById('f-hero-pv-txt').innerText = hero.PV + " / " + hero.PVMax;
                document.getElementById('f-hero-pv-bar').style.width = (hero.PV / hero.PVMax * 100) + "%";

                document.getElementById('m-nom').innerText = monstre.Nom;
                document.getElementById('m-avatar').innerText = getMonsterEmoji(monstre.Nom);
                document.getElementById('m-pv-txt').innerText = monstre.PV + " / " + monstre.PVMax;
                document.getElementById('m-pv-bar').style.width = (monstre.PV / monstre.PVMax * 100) + "%";

                // Animation Dégâts Monstre
                if (lastMonsterHP !== -1 && monstre.PV < lastMonsterHP) {
                    let mpnl = document.getElementById('monster-fighter');
                    mpnl.classList.remove('damage-shake');
                    void mpnl.offsetWidth;
                    mpnl.classList.add('damage-shake');
                }
                lastMonsterHP = monstre.PV;

                // Mise à jour de la boite de logs uniquement s'il y a des nouveaux messages
                if (logs.length > lastLogCount || logs.length === 0) {
                    let logHTML = "";
                    logs.forEach(log => {
                        logHTML += `<div class="log-entry">${log}</div>`;
                    });
                    
                    let logBox = document.getElementById('combat-logs');
                    let isScrolledToBottom = logBox.scrollHeight - logBox.clientHeight <= logBox.scrollTop + 5;
                    
                    logBox.innerHTML = logHTML;
                    
                    // Auto-scroll pour toujours voir la dernière action
                    if (isScrolledToBottom || logs.length > lastLogCount) {
                        logBox.scrollTop = logBox.scrollHeight;
                    }
                    lastLogCount = logs.length;
                }

            } else {
                document.getElementById('combat-idle').style.display = "block";
                document.getElementById('combat-active').style.display = "none";
                document.getElementById('arena-panel').style.borderColor = "var(--neon-blue)";
                lastMonsterHP = -1;
                lastLogCount = 0;
            }

        } catch (e) {}
    }

    setInterval(updateDashboard, 300);
</script>

</body>
</html>